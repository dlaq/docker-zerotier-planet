# 引导密钥。scripts/manage.sh 会在 /etc/ztplanet/runtime.env 中生成随机值；
# 绝对不能提交实际生成文件。
ZTPLANET_RELEASE=v1.1.4
POSTGRES_USER=ztnet
POSTGRES_DB=ztnet
POSTGRES_PASSWORD=请替换为长随机值
DATABASE_URL=postgresql://ztnet:请替换为长随机值@postgres:5432/ztnet?schema=public
NEXTAUTH_SECRET=请替换为至少32字节的随机值
# 认证策略（运行时读取；修改后重启 ztnet）。默认至少 14 位、三类字符中至少两类。
ZTPLANET_PASSWORD_MIN_LENGTH=14
ZTPLANET_PASSWORD_MIN_CLASSES=2
ZTPLANET_TRUST_PROXY=true
# 反向代理网段（仅信任该来源提供的 X-Forwarded-For）；默认值对应 Compose 内部网络。
ZTPLANET_TRUSTED_PROXIES=172.31.255.0/24
ZTPLANET_REGISTER_RATE_LIMIT_WINDOW=10
ZTPLANET_REGISTER_RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_REQUESTS_SHORT=10
ZTPLANET_LOGIN_ATTEMPTS=5
ZTPLANET_LOGIN_LOCKOUT_SECONDS=900
# Message Pusher 不从 .env 读取。请登录管理端“邮件设置”填写并保存；令牌会加密保存在数据库。
# 生产机不能直连外网时，可填写只供 Message Pusher 使用的 HTTP(S) 正向代理；留空表示直连。
ZTPLANET_MESSAGE_PUSHER_PROXY=
OAUTH_ALLOW_DANGEROUS_EMAIL_LINKING=false

# 主备 Controller（可选）。两台 VPS 都保存同一份 Controller 数据和逐字节相同的
# Planet；任意时刻只允许一台运行 zerotier。用 scripts/ha-controller.sh promote/demote
# 做人工切换，不启用没有共识机制的自动双主。standalone 表示不参与主备。
ZTPLANET_HA_MODE=standalone
ZTPLANET_HA_NODE_ID=
ZTPLANET_HA_PEER=
# 仅供 ha-controller.sh 读取的 root-owned KEY=VALUE 文件；不要把 identity.secret 写入其中。
ZTPLANET_HA_ENV_FILE=/etc/ztplanet/ha.env
ZTPLANET_HA_STATE_DIR=/etc/ztplanet/ha
ZTPLANET_HA_LEASE_FILE=/etc/ztplanet/ha/active.lease
# 两台机器可固定校验值，防止误把不同 Planet 提升为主节点。
ZTPLANET_HA_EXPECTED_PLANET_SHA256=
