+
+namespace {
+constexpr int64_t RELAY_FLOW_ACTIVE_MS = 120000;
+constexpr int64_t RELAY_FLOW_RETENTION_MS = 900000;
+constexpr size_t RELAY_FLOW_LIMIT = 8192;
+
+struct RelayFlowKey {
+	uint64_t source;
+	uint64_t destination;
+	ZeroTier::Metrics::RelayTransport transport;
+
+	bool operator<(const RelayFlowKey& other) const
+	{
+		if (source != other.source)
+			return source < other.source;
+		if (destination != other.destination)
+			return destination < other.destination;
+		return static_cast<unsigned int>(transport) < static_cast<unsigned int>(other.transport);
+	}
+};
+
+struct RelayFlowValue {
+	uint64_t packets = 0;
+	uint64_t bytes = 0;
+	int64_t firstSeen = 0;
+	int64_t lastSeen = 0;
+};
+
+struct RelayClientValue {
+	uint64_t packetsIn = 0;
+	uint64_t packetsOut = 0;
+	uint64_t bytesIn = 0;
+	uint64_t bytesOut = 0;
+	int64_t lastRelayedAt = 0;
+};
+
+std::mutex relayTelemetryMutex;
+std::map<RelayFlowKey, RelayFlowValue> relayFlows;
+uint64_t relayTelemetryDroppedFlows = 0;
+const int64_t relayTelemetryBootTime = []() {
+	return std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::system_clock::now().time_since_epoch())
+			.count();
+}();
+
+uint64_t addSaturating(uint64_t left, uint64_t right)
+{
+	if (std::numeric_limits<uint64_t>::max() - left < right)
+		return std::numeric_limits<uint64_t>::max();
+	return left + right;
+}
+
+std::string relayNodeId(uint64_t address)
+{
+	char buf[32];
+	std::snprintf(buf, sizeof(buf), "%010llx", static_cast<unsigned long long>(address));
+	return std::string(buf);
+}
+
+const char* relayTransportName(ZeroTier::Metrics::RelayTransport transport)
+{
+	return transport == ZeroTier::Metrics::RelayTransport::TCP ? "tcp_relay" : "udp_relay";
+}
+
+void pruneRelayFlows(int64_t now)
+{
+	for (auto it = relayFlows.begin(); it != relayFlows.end();) {
+		if ((it->second.lastSeen > 0) && ((now - it->second.lastSeen) > RELAY_FLOW_RETENTION_MS))
+			it = relayFlows.erase(it);
+		else
+			++it;
+	}
+}
+
+void evictOldestRelayFlow()
+{
+	if (relayFlows.empty())
+		return;
+	auto oldest = relayFlows.begin();
+	for (auto it = std::next(relayFlows.begin()); it != relayFlows.end(); ++it) {
+		if (it->second.lastSeen < oldest->second.lastSeen)
+			oldest = it;
+	}
+	relayFlows.erase(oldest);
+	++relayTelemetryDroppedFlows;
+}
+} // namespace
+
