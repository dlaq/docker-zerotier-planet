 namespace ZeroTier {
 namespace Metrics {
+
+void recordRelayForward(uint64_t source, uint64_t destination, RelayTransport transport, unsigned int bytes, int64_t now)
+{
+	if (!source || !destination || source == destination || !bytes)
+		return;
+	std::lock_guard<std::mutex> lock(relayTelemetryMutex);
+	pruneRelayFlows(now);
+	const RelayFlowKey key { source, destination, transport };
+	auto it = relayFlows.find(key);
+	if (it == relayFlows.end()) {
+		if (relayFlows.size() >= RELAY_FLOW_LIMIT)
+			evictOldestRelayFlow();
+		it = relayFlows.emplace(key, RelayFlowValue {}).first;
+		it->second.firstSeen = now;
+	}
+	it->second.packets = addSaturating(it->second.packets, 1);
+	it->second.bytes = addSaturating(it->second.bytes, bytes);
+	it->second.lastSeen = now;
+}
+
+std::string relayTelemetryJson(uint64_t observerId, int64_t now)
+{
+	std::lock_guard<std::mutex> lock(relayTelemetryMutex);
+	pruneRelayFlows(now);
+
+	using json = nlohmann::json;
+	json out = json::object();
+	out["version"] = 1;
+	out["observerId"] = relayNodeId(observerId);
+	out["bootId"] = std::to_string(relayTelemetryBootTime);
+	out["clock"] = now;
+	out["confidence"] = "wire_observed";
+	out["networkId"] = nullptr;
+	out["transport"] = "controller_udp";
+	out["flows"] = json::array();
+	out["clients"] = json::array();
+	out["sessions"] = json::array();
+	out["unattributed"] = json { { "packets", "0" }, { "bytes", "0" } };
+
+	std::map<uint64_t, RelayClientValue> clients;
+	for (const auto& [key, value] : relayFlows) {
+		json flow = json::object();
+		flow["sourceNodeId"] = relayNodeId(key.source);
+		flow["destinationNodeId"] = relayNodeId(key.destination);
+		flow["transport"] = relayTransportName(key.transport);
+		flow["packets"] = std::to_string(value.packets);
+		flow["bytes"] = std::to_string(value.bytes);
+		flow["firstSeen"] = value.firstSeen;
+		flow["lastSeen"] = value.lastSeen;
+		flow["active"] = (value.lastSeen > 0) && ((now - value.lastSeen) <= RELAY_FLOW_ACTIVE_MS);
+		out["flows"].push_back(std::move(flow));
+
+		RelayClientValue& source = clients[key.source];
+		source.packetsOut = addSaturating(source.packetsOut, value.packets);
+		source.bytesOut = addSaturating(source.bytesOut, value.bytes);
+		source.lastRelayedAt = std::max(source.lastRelayedAt, value.lastSeen);
+		RelayClientValue& destination = clients[key.destination];
+		destination.packetsIn = addSaturating(destination.packetsIn, value.packets);
+		destination.bytesIn = addSaturating(destination.bytesIn, value.bytes);
+		destination.lastRelayedAt = std::max(destination.lastRelayedAt, value.lastSeen);
+	}
+
+	for (const auto& [nodeId, value] : clients) {
+		json client = json::object();
+		client["nodeId"] = relayNodeId(nodeId);
+		client["packetsIn"] = std::to_string(value.packetsIn);
+		client["packetsOut"] = std::to_string(value.packetsOut);
+		client["bytesIn"] = std::to_string(value.bytesIn);
+		client["bytesOut"] = std::to_string(value.bytesOut);
+		client["bytesTotal"] = std::to_string(addSaturating(value.bytesIn, value.bytesOut));
+		client["lastRelayedAt"] = value.lastRelayedAt;
+		out["clients"].push_back(std::move(client));
+	}
+
+	out["droppedFlows"] = std::to_string(relayTelemetryDroppedFlows);
+	return out.dump();
+}
