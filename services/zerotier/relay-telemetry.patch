+// Parse only the unencrypted ZeroTier wire header. The outer source and
+// destination addresses are available before forwarding; the encrypted
+// payload is deliberately never inspected or treated as authenticated here.
+static bool _relayPacketAddresses(const void* data, unsigned int len, uint64_t localNode, uint64_t& source, uint64_t& destination)
+{
+	if ((! data) || (len < ZT_PROTO_MIN_PACKET_LENGTH))
+		return false;
+	const uint8_t* raw = reinterpret_cast<const uint8_t*>(data);
+	destination = Address(raw + ZT_PACKET_IDX_DEST, ZT_ADDRESS_LENGTH).toInt();
+	source = Address(raw + ZT_PACKET_IDX_SOURCE, ZT_ADDRESS_LENGTH).toInt();
+	return (source && destination && (source != destination) && (source != localNode) && (destination != localNode));
+}
