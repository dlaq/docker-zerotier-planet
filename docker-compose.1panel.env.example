# ZeroTier Planet + ZTNet 1Panel 完整环境文件示例
# =================================================
# 本文件只包含部署时可由 docker-compose.1panel.yml 读取的设置。
#
# 使用方法：
#   1. 将本文件复制到 Compose 文件同一目录并命名为 .env：
#        cp docker-compose.1panel.env.example .env
#   2. 至少修改下面标为“必须替换”的两行密钥，并执行 chmod 600 .env；网络需要时再调整其它值。
#      生成命令：openssl rand -hex 32（数据库）和 openssl rand -hex 48（认证）。
#   3. 标准 Docker Compose 会自动读取 .env；1Panel“粘贴 Compose”模式若不读取该文件，
#      请把同样的键值逐项填入 1Panel 的“环境变量”区域。
#
# 安全提醒：本示例为了个人测试把网页登录密码策略降为 8 位/1 类字符，并打开 TCP relay。
# 这不是安全默认值。relay 外层是 ZeroTier fallback 的伪 TLS framing，不是真 TLS，也没有
# 协议级客户端认证；公网使用时至少用云防火墙和 RELAY_ALLOWED_CIDRS 限制来源，验收后建议
# 把密码策略恢复为 14 位/2 类字符。不要把本文件（尤其是填好密钥后）提交到 Git 或发给他人。

# ── 1. 必填密钥 ───────────────────────────────────────────────────────────────
# ZTPLANET_DB_PASSWORD：PostgreSQL 数据库密码。每个 VPS/实例必须不同；不是网页登录密码。
# 例如：先执行“openssl rand -hex 32”，再把输出（64 个十六进制字符）粘贴到等号后。
ZTPLANET_DB_PASSWORD=

# ZTPLANET_AUTH_SECRET：用于登录会话、令牌和加密派生。丢失会使现有会话失效；每个实例必须不同。
# 例如：先执行“openssl rand -hex 48”，再把输出（96 个十六进制字符）粘贴到等号后。
ZTPLANET_AUTH_SECRET=

# ── 2. Compose profile ───────────────────────────────────────────────────────
# COMPOSE_PROFILES：决定是否创建可选服务。relay 表示启用 TCP fallback 中继；留空表示关闭。
# 例如：COMPOSE_PROFILES=relay 会让“docker compose up -d”同时创建 relay 容器。
COMPOSE_PROFILES=relay

# ── 3. 管理端监听 ─────────────────────────────────────────────────────────────
# MANAGEMENT_BIND_ADDRESS：宿主机实际监听的本地 IP。127.0.0.1 只能通过 SSH 隧道访问，最安全。
# 例如：MANAGEMENT_BIND_ADDRESS=192.168.10.20 只在该内网地址监听；0.0.0.0 会包含公网地址。
MANAGEMENT_BIND_ADDRESS=127.0.0.1

# MANAGEMENT_HOST：生成 HTTPS 站点和登录回调使用的主机名。动态公网 IP 可留空；不要把 0.0.0.0
# 当作浏览器地址。留空/0.0.0.0 会接受当前 Host，并使用 localhost 自签名证书作为回退。
# 例如：MANAGEMENT_HOST=panel.example.com 可让固定域名访问；动态 IP 示例为 MANAGEMENT_HOST=。
MANAGEMENT_HOST=

# MANAGEMENT_PORT：宿主机管理端 TCP 端口；容器内部端口固定为 3443。修改后要重建编排。
# 例如：MANAGEMENT_PORT=8443 后，通过 https://localhost:8443（或对应绑定地址）访问。
MANAGEMENT_PORT=3443
# 1Panel 状态页展示用的可选细化设置；实际网关端口仍由上面两项决定。
MANAGEMENT_ALLOWED_CIDRS=

# ── 4. ZTNet 登录与请求保护 ──────────────────────────────────────────────────
# ZTPLANET_PASSWORD_MIN_LENGTH：网页登录密码最小长度。代码会限制在 8-128；本示例为个人使用放宽到 8。
# 例如：注册时“ztadmin1”长度为 8，可满足本示例；首次登录后请改成更长的密码。
ZTPLANET_PASSWORD_MIN_LENGTH=8

# ZTPLANET_PASSWORD_MIN_CLASSES：密码至少包含几类字符（小写/大写/数字），范围 1-3。本示例设为 1。
# 例如：设为 2 时“ztadmin1”仍满足（小写+数字）；设为 1 时“12345678”也会满足，风险更高。
ZTPLANET_PASSWORD_MIN_CLASSES=1

# ZTPLANET_TRUST_PROXY：是否信任内置 Caddy 传来的 X-Forwarded-For，以便限流按真实客户端 IP 分桶。
# 例如：true 是本 Compose 的正常值；直连 ZTNet 或使用不可信反代时应设为 false。
ZTPLANET_TRUST_PROXY=true

# ZTPLANET_TRUSTED_PROXIES：允许提供代理头的 Docker 反代网段，逗号分隔；禁止写“*”。
# 例如：172.31.255.0/24 是本 Compose 的 app-network；更换反代网段时改为其精确 CIDR。
ZTPLANET_TRUSTED_PROXIES=172.31.255.0/24

# ZTPLANET_REGISTER_RATE_LIMIT_WINDOW：注册限流窗口，单位为分钟。按客户端 IP 计算。
# 例如：10 表示每个 IP 使用下面的注册次数额度后，10 分钟内暂时不能继续注册。
ZTPLANET_REGISTER_RATE_LIMIT_WINDOW=10

# ZTPLANET_REGISTER_RATE_LIMIT_MAX：上面窗口内每个客户端 IP 允许的注册请求数。
# 例如：60 表示 10 分钟最多 60 次；生产环境可改小以减少暴力尝试。
ZTPLANET_REGISTER_RATE_LIMIT_MAX=60

# RATE_LIMIT_WINDOW：其他认证接口（重置密码、验证链接等）的限流窗口，单位为分钟。
# 例如：10 表示这些接口按 10 分钟窗口计数。
RATE_LIMIT_WINDOW=10

# RATE_LIMIT_MAX_REQUESTS：普通认证操作在一个窗口中的最大请求数。
# 例如：60 可允许正常重试；公网环境不建议无限增大。
RATE_LIMIT_MAX_REQUESTS=60

# RATE_LIMIT_MAX_REQUESTS_SHORT：敏感认证操作在一个窗口中的最大请求数。
# 例如：10 限制密码重置/邮箱验证等接口，降低滥用和邮件轰炸风险。
RATE_LIMIT_MAX_REQUESTS_SHORT=10

# ZTPLANET_LOGIN_ATTEMPTS：单个账户连续失败多少次后触发登录锁定，范围由程序限制。
# 例如：5 表示连续输错 5 次进入锁定，而不是禁止注册。
ZTPLANET_LOGIN_ATTEMPTS=5

# ZTPLANET_LOGIN_LOCKOUT_SECONDS：登录锁定持续秒数；仅影响已有账户登录。
# 例如：900 表示锁定 15 分钟；修改后重建 ztnet 才会加载新值。
ZTPLANET_LOGIN_LOCKOUT_SECONDS=900

# ── 4a. Message Pusher 通知（可选） ──────────────────────────────────────────
# MESSAGE_PUSHER_ENABLED 仅控制是否额外发送推送；可与 SMTP 同时使用，也可只启用推送。
# 例如：true 表示登录、邀请、设备和安全通知会调用下方的 message-pusher。
MESSAGE_PUSHER_ENABLED=false

# MESSAGE_PUSHER_URL：自建 message-pusher 根地址，不要填写 /push/用户名、查询参数或凭据。
# 例如：https://push.example.com 或 http://message-pusher:3000（同一 Compose 网络）。
MESSAGE_PUSHER_URL=

# MESSAGE_PUSHER_USERNAME：message-pusher 的用户名，程序会安全编码到 /push/<用户名> 路径。
# 例如：ztnet。
MESSAGE_PUSHER_USERNAME=

# MESSAGE_PUSHER_TOKEN：访问令牌；仅在管理端提交时加密写入 PostgreSQL，不要提交到仓库。
# 例如：从 message-pusher 管理界面复制的 token。
MESSAGE_PUSHER_TOKEN=

# MESSAGE_PUSHER_CHANNEL：可选渠道名，例如 telegram、serverchan 或 webhook；留空使用服务端默认渠道。
MESSAGE_PUSHER_CHANNEL=

# ── 5. ZeroTier Planet UDP ───────────────────────────────────────────────────
# ZT_ALLOW_MANAGEMENT_FROM：允许哪些容器/地址访问 ZeroTier Controller HTTP API，逗号分隔。
# 默认只允许本编排内 ZTNet 的固定地址 172.31.255.3/32；不要为了省事填写 0.0.0.0/0。
# 例如：ZT_ALLOW_MANAGEMENT_FROM=172.31.255.3/32,127.0.0.1/32 可额外允许本机诊断。
ZT_ALLOW_MANAGEMENT_FROM=172.31.255.3/32

# ZT_BIND_ADDRESS：宿主机 UDP 端口绑定的 IP。0.0.0.0 表示所有本地地址，便于动态公网 IP。
# 例如：ZT_BIND_ADDRESS=192.168.10.20 只在指定内网地址接收 UDP。
ZT_BIND_ADDRESS=0.0.0.0

# ZT_PUBLIC_PORT：宿主机对外提供 Planet/根节点服务的 UDP 端口，默认官方常用 9993。
# 例如：ZT_PUBLIC_PORT=19993 后云防火墙也必须放行 UDP/19993，并重新分发对应 Planet/Moon。
ZT_PUBLIC_PORT=9993
ZT_ENABLED=true
ZT_ALLOW_MANAGEMENT_UI=false
ZT_MANAGEMENT_INTERFACE=
ZT_MANAGEMENT_ADDRESS=
ZT_SECONDARY_PORT=0
ZT_TERTIARY_PORT=0
ZT_ALLOW_SECONDARY_PORT=true
ZT_PORT_MAPPING_ENABLED=true
CONTROLLER_BIND_ADDRESS=127.0.0.1
CONTROLLER_PORT=9993
CONTROLLER_EXPOSURE=internal

# ── 6. TCP fallback relay（本示例已开启） ────────────────────────────────────
# RELAY_BIND_ADDRESS：宿主机 relay TCP 监听的本地 IP。0.0.0.0 表示公开到所有本地地址。
# 例如：改为 203.0.113.20 可只绑定指定公网地址（该地址必须实际存在于宿主机）。
RELAY_BIND_ADDRESS=0.0.0.0

# RELAY_PUBLIC_PORT：宿主机公开的 relay TCP 端口，443 不是固定要求；容器内部端口固定为 4443。
# 例如：4443 无需特权端口；若运营商只放行 443，可改为 RELAY_PUBLIC_PORT=443。
RELAY_PUBLIC_PORT=4443

# RELAY_ALLOWED_CIDRS：允许连接 relay 的客户端 IPv4 来源 CIDR，多个值用逗号分隔；留空=任意来源。
# 例如：RELAY_ALLOWED_CIDRS=198.51.100.24/32 只允许一台客户端。留空便于测试但公网风险最高。
RELAY_ALLOWED_CIDRS=

# RELAY_METRICS_LISTEN：relay 容器内指标监听地址，不映射到宿主机；留空可关闭指标端点。
# 例如：172.31.254.2:9090 只在 relay 专用 Docker 网段提供健康/指标数据。
RELAY_METRICS_LISTEN=172.31.254.2:9090

# RELAY_MAX_CONNECTIONS：relay 全局同时连接数上限，防止连接洪泛耗尽内存/文件描述符。
# 例如：128 表示最多 128 条 TCP relay 连接。
RELAY_MAX_CONNECTIONS=128

# RELAY_MAX_CONNECTIONS_PER_IP：同一来源 IP 的并发连接上限，防止单个地址独占资源。
# 例如：4 表示一个公网 IP 最多同时 4 条连接。
RELAY_MAX_CONNECTIONS_PER_IP=4

# RELAY_HANDSHAKE_TIMEOUT_SECONDS：relay 握手必须完成的秒数，防止 Slowloris 长时间占连接。
# 例如：10 表示 10 秒内没有完成协议握手就断开。
RELAY_HANDSHAKE_TIMEOUT_SECONDS=10

# RELAY_IDLE_TIMEOUT_SECONDS：连接空闲多久后关闭，单位为秒。
# 例如：300 表示 5 分钟没有数据就释放连接；需要长期空闲隧道时再调大。
RELAY_IDLE_TIMEOUT_SECONDS=300

# RELAY_PACKETS_PER_SECOND：单条连接每秒允许转发的 UDP 包数。
# 例如：200 限制单连接包速率，降低滥用和 CPU 消耗。
RELAY_PACKETS_PER_SECOND=200

# RELAY_BYTES_PER_SECOND：单条连接每秒允许转发的字节数（B/s）。
# 例如：2097152 约为 2 MiB/s；调大可提高吞吐，也会增加公网带宽风险。
RELAY_BYTES_PER_SECOND=2097152

# RELAY_GLOBAL_PACKETS_PER_SECOND：整个 relay 实例每秒允许转发的 UDP 包数。
# 例如：2000 是所有连接共享的总上限。
RELAY_GLOBAL_PACKETS_PER_SECOND=2000

# RELAY_GLOBAL_BYTES_PER_SECOND：整个 relay 实例每秒允许转发的总字节数（B/s）。
# 例如：20971520 约为 20 MiB/s，是所有连接共享的总带宽上限。
RELAY_GLOBAL_BYTES_PER_SECOND=20971520

# RELAY_MAX_DESTINATIONS：单条连接最多同时使用的 UDP 目标数量。
# 例如：64 防止利用 relay 扫描大量目标地址。
RELAY_MAX_DESTINATIONS=64

# RELAY_MIN_DESTINATION_PORT：允许 relay 访问的目标 UDP 最小端口；程序还会阻断私网/回环等地址。
# 例如：1025 会拒绝目标端口 1-1024，降低访问系统服务的风险。
RELAY_MIN_DESTINATION_PORT=1025

# RELAY_MAX_FRAME_LENGTH：单个 fallback 协议帧的最大字节数，范围 23-65535。
# 例如：4096 足够常规 ZeroTier 包；调大前应评估内存和 DoS 风险。
RELAY_MAX_FRAME_LENGTH=4096

# ── 7. 当前 Compose 固定的项目设置（不是可填写的环境变量） ─────────────────
# TLS：gateway 固定使用 Caddy tls internal，自签名 CA 保存在 ./data/gateway-data；本文件没有
# TLS_MODE/证书路径开关。首次访问会出现证书警告；需要公网可信证书时应在受控反代终止 TLS。
# 管理端容器内部固定监听 ztnet:3000，relay 容器内部固定监听 4443；上面的 *_PORT 是宿主机端口。
# 所有持久化数据均为 ./data/* bind 挂载，不使用 Docker named volume。
