# 供 docker-compose.1panel.yml 使用的可选环境文件。
# 将本文件复制为 Compose 同目录下的 .env，并执行 chmod 600 .env。
# Docker Compose 会自动读取同目录的 .env；1Panel 粘贴模式若不自动读取，
# 请把相同的键值填入编排的“环境变量”区域。

# 必填：每个实例都必须使用独立随机值
ZTPLANET_DB_PASSWORD=请替换为openssl-rand-hex-32的输出
ZTPLANET_AUTH_SECRET=请替换为openssl-rand-hex-48的输出

# 管理端。MANAGEMENT_HOST 可以留空或设置为 0.0.0.0；这两种值都会接受动态公网 IP，
# 并使用 localhost 的内部自签名证书作为 TLS 回退（浏览器会提示名称不匹配）。
# 需要无提示访问时请使用稳定的动态 DNS 名称。MANAGEMENT_BIND_ADDRESS=0.0.0.0
# 只表示绑定全部宿主机地址，会扩大公网暴露面，必须配合云防火墙限制来源。
MANAGEMENT_BIND_ADDRESS=127.0.0.1
MANAGEMENT_HOST=localhost
MANAGEMENT_PORT=3443

# 认证策略。默认密码至少 14 位，并且至少包含小写、大写、数字中的两类。
# 个人使用可把长度降到 8，或把类别数设为 1；服务端会把 1-7 和 0 自动钳制为安全下限。
ZTPLANET_PASSWORD_MIN_LENGTH=14
ZTPLANET_PASSWORD_MIN_CLASSES=2
# bundled Caddy 是可信反向代理；启用后限流按真实客户端 IP 分桶，而不是所有用户共享一桶。
ZTPLANET_TRUST_PROXY=true

# 注册限流（按客户端 IP；修改后需重启 ztnet）。默认每个 IP 10 分钟最多 60 次。
# 不建议设为 0；错误值会回退到默认值。
ZTPLANET_REGISTER_RATE_LIMIT_WINDOW=10
ZTPLANET_REGISTER_RATE_LIMIT_MAX=60
# 其他认证接口限流（密码重置、验证链接等）。
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_REQUESTS_SHORT=10
# 登录失败锁定：达到次数后锁定指定秒数；仅影响已有账户登录，不影响注册。
ZTPLANET_LOGIN_ATTEMPTS=5
ZTPLANET_LOGIN_LOCKOUT_SECONDS=900

# ZeroTier Planet UDP 入口
ZT_BIND_ADDRESS=0.0.0.0
ZT_PUBLIC_PORT=9993

# TCP fallback relay 默认关闭；需要时再取消注释并填写来源限制。
# COMPOSE_PROFILES=relay
# RELAY_BIND_ADDRESS=0.0.0.0
# RELAY_PUBLIC_PORT=443
# RELAY_ALLOWED_CIDRS=可信客户端公网IP/32
