# 供 docker-compose.1panel.yml 使用的可选环境文件。
# 将本文件复制为 Compose 同目录下的 .env，并执行 chmod 600 .env。
# Docker Compose 会自动读取同目录的 .env；1Panel 粘贴模式若不自动读取，
# 请把相同的键值填入编排的“环境变量”区域。

# 必填：每个实例都必须使用独立随机值
ZTPLANET_DB_PASSWORD=请替换为openssl-rand-hex-32的输出
ZTPLANET_AUTH_SECRET=请替换为openssl-rand-hex-48的输出

# 管理端。动态公网 IP 建议保持 MANAGEMENT_BIND_ADDRESS=127.0.0.1、
# MANAGEMENT_HOST=localhost 并使用 SSH 隧道；需要直接访问时请使用动态 DNS 名称。
# MANAGEMENT_BIND_ADDRESS=0.0.0.0 只表示绑定全部宿主机地址，会扩大公网暴露面。
MANAGEMENT_BIND_ADDRESS=127.0.0.1
MANAGEMENT_HOST=localhost
MANAGEMENT_PORT=3443

# ZeroTier Planet UDP 入口
ZT_BIND_ADDRESS=0.0.0.0
ZT_PUBLIC_PORT=9993

# TCP fallback relay 默认关闭；需要时再取消注释并填写来源限制。
# COMPOSE_PROFILES=relay
# RELAY_BIND_ADDRESS=0.0.0.0
# RELAY_PUBLIC_PORT=443
# RELAY_ALLOWED_CIDRS=可信客户端公网IP/32
